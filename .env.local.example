# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this on the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin secret — used to authenticate admin-only API routes
ADMIN_SECRET_KEY=change-me-to-a-long-random-string

# Resend (email) — https://resend.com — 3.000 emails/mes gratis
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio verificado en Resend. En dev podés usar: Canchas <onboarding@resend.dev>
RESEND_FROM_EMAIL=Canchas <reservas@tudominio.com>

# Public URL of the app (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
